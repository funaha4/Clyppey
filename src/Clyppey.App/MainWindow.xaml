<Window x:Class="Clyppey.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Clyppey.App"
        Title="Clyppey"
        Width="1180" Height="820"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{StaticResource BgBrush}"
        Icon="Assets/clyppey.ico"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <local:ClipModeTextConverter x:Key="ClipModeText" />

        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource H2}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One clip row, shared by the home and history lists. -->
        <DataTemplate x:Key="ClipItemTemplate">
            <Border Style="{StaticResource Tile}" Padding="14,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="{Binding Mode, Converter={StaticResource ClipModeText}}" />
                            <TextBlock Style="{StaticResource Caption}" Text="  ·  " />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="{Binding DurationSeconds, StringFormat={}{0:F1} s}" />
                            <TextBlock Style="{StaticResource Caption}" Text="  ·  " />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding SizeText}" />
                            <TextBlock Style="{StaticResource Caption}" Text="  ·  " />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="{Binding CreatedAt, StringFormat={}{0:MM/dd HH:mm}}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{DynamicResource Clips.Trim}" Style="{StaticResource BaseButton}"
                                Padding="13,6" FontSize="12" Click="TrimClip_Click" Tag="{Binding}" />
                        <Button Content="{DynamicResource Clips.Open}" Style="{StaticResource BaseButton}"
                                Padding="13,6" FontSize="12" Margin="4,0,0,0" Click="OpenClip_Click" Tag="{Binding}" />
                        <Button Content="{DynamicResource Clips.Folder}" Style="{StaticResource GhostButton}"
                                Padding="11,6" FontSize="12" Margin="4,0,0,0"
                                Click="RevealClip_Click" Tag="{Binding}" />
                        <Button Content="{DynamicResource Clips.Delete}" Style="{StaticResource GhostButton}"
                                Padding="10,6" FontSize="12" Margin="2,0,0,0"
                                Click="DeleteClip_Click" Tag="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================== title bar ============================== -->
            <Grid Grid.Row="0" Background="{StaticResource NavBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                                <Grid Width="64" Height="64">
                                    <Border CornerRadius="16" Background="#12151B" />
                                    <Ellipse Margin="12" Stroke="#A3E635" StrokeThickness="5"
                                             StrokeDashArray="7 2.8" StrokeDashOffset="1.4"
                                             StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Path Fill="#F5F8FC" Data="M 27,23 L 41,32 L 27,41 Z" />
                                </Grid>
                            </Viewbox>
                    <TextBlock Text="{DynamicResource App.Title}" FontWeight="Bold" FontSize="13.5"
                               Margin="9,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource App.Tagline}" Style="{StaticResource Caption}"
                               FontSize="9.5" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource PillGroup}" VerticalAlignment="Center"
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Lang" Content="EN" Style="{StaticResource Pill}"
                                     IsChecked="{Binding IsEnglish, Mode=TwoWay}" />
                        <RadioButton GroupName="Lang" Content="日本語" Style="{StaticResource Pill}"
                                     IsChecked="{Binding IsJapanese, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Button Style="{StaticResource WindowButton}" Click="Minimize_Click"
                            ToolTip="{DynamicResource Header.Minimize}">
                        <TextBlock Text="&#xE921;" Style="{StaticResource Ico}" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="CloseToTray_Click"
                            Margin="4,0,0,0" ToolTip="{DynamicResource Header.Close}">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource Ico}" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================== body ============================== -->
            <TabControl x:Name="Nav" Grid.Row="1" Style="{StaticResource NavTabControl}">

                <!-- ===== HOME ===== -->
                <TabItem Style="{StaticResource NavTabItem}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource Ico}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" />
                            <TextBlock Text="{DynamicResource Nav.Home}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="24,16,24,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- state, timeline and the three actions -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10"
                                Opacity="0">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" VerticalAlignment="Center">
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1" To="0.35" Duration="0:0:1.1"
                                                                             AutoReverse="True" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <TextBlock Text="{Binding StateLabel}" FontSize="12.5" FontWeight="SemiBold"
                                                   Margin="7,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="·" Margin="8,0" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BufferRangeLabel}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="·" Margin="8,0" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding EncoderBadge}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Grid Height="26" Margin="0,13,0,0" ToolTip="{Binding BufferedOfText}">
                                        <Border CornerRadius="6" Background="#090C10"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                                        <ProgressBar Value="{Binding BufferPercent, Mode=OneWay}" Maximum="100"
                                                     Height="6" Margin="8,0" VerticalAlignment="Center"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{StaticResource AccentBrush}" />
                                    </Grid>

                                    <DockPanel Margin="0,7,0,0">
                                        <TextBlock Text="{Binding BufferedOfText}" Style="{StaticResource Caption}" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                   Text="{Binding MemoryEstimateText}" Style="{StaticResource Caption}" />
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="SaveButton" Click="SaveReplay_Click" IsEnabled="{Binding CanSave}"
                                            Height="52" MinWidth="168" Cursor="Hand" Foreground="#04201D">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Face" CornerRadius="10" Background="#2DD4BF"
                                                        BorderBrush="#57E6D3" BorderThickness="1">
                                                    <Grid Margin="16,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                                                   Foreground="#04201D" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{DynamicResource Action.Save}" FontSize="14"
                                                                       FontWeight="SemiBold" Foreground="#04201D" />
                                                            <TextBlock Text="{Binding SaveHotkeyLabel}" FontSize="10"
                                                                       Foreground="#0B4A43" Margin="0,1,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Face" Property="Background" Value="#3FE3CE" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Face" Property="Background" Value="#22B8A6" />
                                                        <Setter TargetName="Face" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="Face" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Face" Property="Opacity" Value="0.35" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Content="{Binding RecordButtonText}" Style="{StaticResource RecordButton}"
                                            Height="52" MinWidth="104" FontSize="12" Margin="8,0,0,0"
                                            Click="ToggleRecord_Click" />
                                    <Button Content="{Binding BufferButtonText}" Style="{StaticResource BaseButton}"
                                            Height="52" MinWidth="104" FontSize="12" Margin="8,0,0,0"
                                            Click="ToggleBuffer_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        
                        <!-- hotkey conflict banner -->
                        <Border Grid.Row="1" Margin="0,0,0,10" Background="#2E2410" BorderBrush="#7A5E1B"
                                BorderThickness="1" CornerRadius="12" Padding="14,10"
                                Visibility="{Binding HasHotkeyWarning, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Ico}" FontSize="15"
                                           Foreground="{StaticResource WarnBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding HotkeyWarning}" TextWrapping="Wrap"
                                           Foreground="#F3DFAC" FontSize="12.5" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- one quiet status line instead of six identical tiles -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,12">
                            <UniformGrid Columns="6">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Stats.CaptureFps}" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="{Binding CaptureFpsText}" FontSize="15" FontWeight="SemiBold"
                                               FontFamily="{StaticResource MonoFont}" Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Stats.Dropped}" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="{Binding DropText}" FontSize="15" FontWeight="SemiBold"
                                               FontFamily="{StaticResource MonoFont}" Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Stats.Cpu}" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="{Binding CpuText}" FontSize="15" FontWeight="SemiBold"
                                               FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrush}"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Stats.Gpu}" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="{Binding GpuText}" FontSize="15" FontWeight="SemiBold"
                                               FontFamily="{StaticResource MonoFont}" Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Stats.Bitrate}" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="{Binding BitrateText}" FontSize="15" FontWeight="SemiBold"
                                               FontFamily="{StaticResource MonoFont}" Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Stats.Resolution}" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="{Binding ResolutionText}" FontSize="15" FontWeight="SemiBold"
                                               FontFamily="{StaticResource MonoFont}" Margin="0,1,0,0" />
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <!-- clips -->
                        <DockPanel Grid.Row="3">
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Clips.Recent}"
                                       Style="{StaticResource H2}" Margin="0,0,0,8" />
                            <Border Style="{StaticResource Card}" Padding="10">
                                <Grid>
                                    <ListBox ItemsSource="{Binding RecentClips}"
                                             ItemTemplate="{StaticResource ClipItemTemplate}"
                                             MouseDoubleClick="ClipList_MouseDoubleClick" />
                                    <TextBlock Text="{DynamicResource Clips.Empty}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Caption}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecentClips.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DockPanel>

                        <!-- footer -->
                        <Grid Grid.Row="4" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource GhostButton}" Padding="6,3" Click="OpenFolder_Click"
                                    ToolTip="{DynamicResource Action.OpenFolder}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Ico}" FontSize="12" />
                                    <TextBlock Text="{Binding OutputDirectoryDisplay}" Style="{StaticResource Caption}"
                                               Margin="7,0,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="#A9B3C2" MaxWidth="700" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding MemoryEstimateText}" Style="{StaticResource Caption}" />
                        </Grid>

                        <!-- toast -->
                        <Border Grid.Row="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Background="#10221F" BorderBrush="{StaticResource AccentDimBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18,11" Margin="0,0,0,34"
                                Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Ico}" FontSize="14"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                                <TextBlock Text="{Binding ToastText}" FontSize="13" FontWeight="SemiBold"
                                           MaxWidth="720" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===== SETTINGS ===== -->
                <TabItem Style="{StaticResource NavTabItem}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Ico}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" />
                            <TextBlock Text="{DynamicResource Nav.Settings}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" Loaded="SettingsView_Loaded">
                        <StackPanel Margin="24,16,24,20">
                            <TextBlock Text="{DynamicResource Settings.Title}" Style="{StaticResource H2}" Margin="0,0,0,14" />

                            <!-- updates -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;" Style="{StaticResource Ico}" FontSize="14" />
                                        <TextBlock Text="{DynamicResource Settings.Update}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" />
                                        <Border Background="#0C1319" CornerRadius="7" Padding="8,3" Margin="10,0,0,0"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Caption}"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Caption}"
                                               Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{DynamicResource Settings.UpdateCheck}" Click="CheckUpdate_Click"
                                                Style="{StaticResource BaseButton}" IsEnabled="{Binding CanCheckUpdate}" />
                                        <Button Content="{DynamicResource Settings.UpdateApply}" Click="ApplyUpdate_Click"
                                                Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                                                IsEnabled="{Binding CanApplyUpdate}"
                                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- which screen gets captured -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F4;" Style="{StaticResource Ico}" FontSize="14" />
                                        <TextBlock Text="{DynamicResource Settings.Screen}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.MonitorHint}" Style="{StaticResource Caption}"
                                               Margin="0,4,0,12" TextWrapping="Wrap" />
                                    <ListBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Margin" Value="0,0,10,8" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Frame" CornerRadius="12" Padding="6"
                                                                    Background="#0D1117" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentDimBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                    <Setter TargetName="Frame" Property="Background" Value="#0F1A1C" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="196">
                                                    <Border CornerRadius="8" ClipToBounds="True" Background="#05070A">
                                                        <Image Source="{Binding Thumbnail}" Height="110" Stretch="UniformToFill" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"
                                                               Margin="2,6,2,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <!-- how far back -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE823;" Style="{StaticResource Ico}" FontSize="14" />
                                        <TextBlock Text="{DynamicResource Settings.Length}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.LengthHint}" Style="{StaticResource Caption}" Margin="0,4,0,12" />
                                    <Slider Minimum="15" Maximum="600" TickFrequency="5" IsSnapToTickEnabled="True"
                                            Value="{Binding BufferSecondsValue, Mode=TwoWay}" />
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBlock Text="{Binding BufferSecondsLabel}" FontWeight="SemiBold" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                   Text="{Binding MemoryEstimateText}" Style="{StaticResource Caption}" />
                                    </DockPanel>
                                    <CheckBox Content="{DynamicResource Settings.BufferOnDisk}" Margin="0,12,0,0"
                                              IsChecked="{Binding BufferOnDisk, Mode=TwoWay}" />
                                    
                                </StackPanel>
                            </Border>

                            <!-- where clips go -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Ico}" FontSize="14" />
                                        <TextBlock Text="{DynamicResource Settings.Output}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.OutputHint}" Style="{StaticResource Caption}" Margin="0,4,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding OutputDirectoryEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Content="{DynamicResource Settings.Browse}" Margin="8,0,0,0"
                                                Style="{StaticResource BaseButton}" Click="BrowseFolder_Click" />
                                    </Grid>
                                    <TextBlock Text="{Binding OutputFallbackNote}" Foreground="{StaticResource WarnBrush}"
                                               FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding OutputDirectoryIsOverridden, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>

                            <!-- quality -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9F5;" Style="{StaticResource Ico}" FontSize="14" />
                                        <TextBlock Text="{DynamicResource Settings.Quality}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" />
                                    </StackPanel>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.Fps}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Grid.Column="1" Width="170" HorizontalAlignment="Left"
                                                  ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding SelectedFps, Mode=TwoWay}" />
                                        <TextBlock Grid.Row="1" Text="{DynamicResource Settings.Bitrate}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                            <Slider Width="220" Minimum="5" Maximum="100" TickFrequency="5"
                                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                    Value="{Binding BitrateMbpsValue, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding BitrateMbpsValue, StringFormat={}{0} Mbps}"
                                                       Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Text="{DynamicResource Settings.Preset}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                            <RadioButton GroupName="Quality" Style="{StaticResource Pill}"
                                                         Content="{DynamicResource Settings.QualityLow}" IsChecked="{Binding QualityLow, Mode=TwoWay}" />
                                            <RadioButton GroupName="Quality" Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                         Content="{DynamicResource Settings.QualityStandard}" IsChecked="{Binding QualityStandard, Mode=TwoWay}" />
                                            <RadioButton GroupName="Quality" Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                         Content="{DynamicResource Settings.QualityHigh}" IsChecked="{Binding QualityHigh, Mode=TwoWay}" />
                                            <RadioButton GroupName="Quality" Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                         Content="{DynamicResource Settings.QualityMax}" IsChecked="{Binding QualityMax, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- sound -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE767;" Style="{StaticResource Ico}" FontSize="14" />
                                        <TextBlock Text="{DynamicResource Settings.Audio}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" />
                                    </StackPanel>
                                    <CheckBox Content="{DynamicResource Settings.DesktopAudioOn}" Margin="0,12,0,0"
                                              IsChecked="{Binding DesktopAudioEnabled, Mode=TwoWay}" />
                                    <ComboBox Margin="0,8,0,0" ItemsSource="{Binding AudioDevices}"
                                              SelectedItem="{Binding SelectedAudioDevice, Mode=TwoWay}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.DesktopLevel}"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ProgressBar Grid.Column="1" Height="8" Maximum="1"
                                                     Value="{Binding DesktopLevel, Mode=OneWay}"
                                                     VerticalAlignment="Center" />
                                    </Grid>
                                    <CheckBox Content="{DynamicResource Settings.MicrophoneOn}" Margin="0,14,0,0"
                                              IsChecked="{Binding MicrophoneEnabled, Mode=TwoWay}" />
                                    <TextBlock Text="{DynamicResource Settings.NoMicrophone}" Margin="0,6,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasMicrophone}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ComboBox Margin="0,8,0,0" ItemsSource="{Binding MicrophoneDevices}"
                                              SelectedItem="{Binding SelectedMicrophone, Mode=TwoWay}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.MicVolume}" Style="{StaticResource FieldLabel}" />
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,12,0"
                                                    Value="{Binding MicrophoneVolume, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1" Text="{Binding MicrophoneVolumeText}"
                                                       Style="{StaticResource Caption}" Width="60" TextAlignment="Right" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{DynamicResource Settings.MicLevel}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                        <ProgressBar Grid.Row="1" Grid.Column="1" Height="8" Margin="0,10,0,0"
                                                     Maximum="1" Value="{Binding MicLevel, Mode=OneWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Text="{DynamicResource Settings.MicDelay}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="-1000" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True"
                                                    Margin="0,0,12,0" Value="{Binding MicrophoneDelayValue, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1" Text="{Binding MicrophoneDelayText}"
                                                       Style="{StaticResource Caption}" Width="66" TextAlignment="Right" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- hotkeys -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE765;" Style="{StaticResource Ico}" FontSize="14" />
                                        <TextBlock Text="{DynamicResource Settings.Hotkeys}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.HotkeysHint}" Style="{StaticResource Caption}"
                                               Margin="0,4,0,12" TextWrapping="Wrap" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.HotkeySave}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button x:Name="HotkeySaveButton" Tag="Save" Click="HotkeyCapture_Click"
                                                    Style="{StaticResource BaseButton}" MinWidth="190" FontWeight="SemiBold" />
                                            <Button Tag="Save" Click="ClearHotkey_Click" Margin="6,0,0,0" Content="&#x00D7;" FontSize="16"
                                                    Style="{StaticResource BaseButton}" Width="38"
                                                    ToolTip="{DynamicResource Settings.HotkeyClear}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{DynamicResource Settings.HotkeyRecord}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                                            <Button x:Name="HotkeyRecordButton" Tag="Record" Click="HotkeyCapture_Click"
                                                    Style="{StaticResource BaseButton}" MinWidth="190" FontWeight="SemiBold" />
                                            <Button Tag="Record" Click="ClearHotkey_Click" Margin="6,0,0,0" Content="&#x00D7;" FontSize="16"
                                                    Style="{StaticResource BaseButton}" Width="38"
                                                    ToolTip="{DynamicResource Settings.HotkeyClear}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Text="{DynamicResource Settings.HotkeyBuffer}" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="HotkeyBufferButton" Tag="Buffer" Click="HotkeyCapture_Click"
                                                    Style="{StaticResource BaseButton}" MinWidth="190" FontWeight="SemiBold" />
                                            <Button Tag="Buffer" Click="ClearHotkey_Click" Margin="6,0,0,0" Content="&#x00D7;" FontSize="16"
                                                    Style="{StaticResource BaseButton}" Width="38"
                                                    ToolTip="{DynamicResource Settings.HotkeyClear}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- start-up and behaviour -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7E8;" Style="{StaticResource Ico}" FontSize="14" />
                                        <TextBlock Text="{DynamicResource Settings.Behaviour}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" />
                                    </StackPanel>
                                    <CheckBox Content="{DynamicResource Settings.AutoBuffer}" Margin="0,12,0,0"
                                              IsChecked="{Binding Settings.AutoStartBuffering, Mode=TwoWay}" />
                                    <CheckBox Content="{DynamicResource Settings.AutoStartWindows}" Margin="0,10,0,0"
                                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                                    <CheckBox Content="{DynamicResource Settings.StartMinimized}" Margin="0,10,0,0"
                                              IsChecked="{Binding Settings.StartMinimized, Mode=TwoWay}" />
                                    <CheckBox Content="{DynamicResource Settings.OpenOnSave}" Margin="0,10,0,0"
                                              IsChecked="{Binding Settings.OpenFolderOnSave, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <!-- rarely touched: keep the defaults -->
                            <Expander Header="{DynamicResource Settings.Advanced}" IsExpanded="False" Margin="0,4,0,0">
                                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.Codec}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding CodecOptions}"
                                                  SelectedItem="{Binding SelectedCodec, Mode=TwoWay}" />
                                        <TextBlock Grid.Row="1" Text="{DynamicResource Settings.RateControl}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" ItemsSource="{Binding RateOptions}"
                                                  SelectedItem="{Binding SelectedRate, Mode=TwoWay}" />
                                        <TextBlock Grid.Row="2" Text="{DynamicResource Settings.SyncOffset}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                            <Slider Width="220" Minimum="-500" Maximum="500" TickFrequency="10"
                                                    IsSnapToTickEnabled="True" Value="{Binding SyncOffsetMs, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding SyncOffsetMs, StringFormat={}{0} ms}"
                                                       Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== HISTORY ===== -->
                <TabItem Style="{StaticResource NavTabItem}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource Ico}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" />
                            <TextBlock Text="{DynamicResource Nav.History}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="26,20,26,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource Clips.History}" Style="{StaticResource H1}" />
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Action.OpenFolder}"
                                    Style="{StaticResource BaseButton}" HorizontalAlignment="Right"
                                    Click="OpenFolder_Click" />
                        </DockPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
                            <Grid>
                                <ListBox ItemsSource="{Binding AllClips}"
                                         ItemTemplate="{StaticResource ClipItemTemplate}"
                                         MouseDoubleClick="ClipList_MouseDoubleClick" />
                                <TextBlock Text="{DynamicResource Clips.EmptyAll}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Caption}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AllClips.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===== DIAGNOSTICS ===== -->
                <TabItem Style="{StaticResource NavTabItem}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Ico}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" />
                            <TextBlock Text="{DynamicResource Nav.Diagnostics}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="26,20,26,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource Diag.Title}" Style="{StaticResource H1}" />
                        </DockPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="{DynamicResource Diag.Redetect}" Style="{StaticResource BaseButton}"
                                    Click="Redetect_Click" />
                            <Button Content="{DynamicResource Diag.OpenLog}" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Click="OpenLog_Click" />
                            <Button Content="{DynamicResource Diag.OpenData}" Style="{StaticResource GhostButton}"
                                    Margin="4,0,0,0" Click="OpenDataFolder_Click" />
                        </StackPanel>

                        <Border Grid.Row="2" Margin="0,0,0,12" CornerRadius="12" Padding="14">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Card}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEnvironmentProblem}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding EnvironmentProblem}" TextWrapping="Wrap"
                                       Foreground="#F3DFAC" FontSize="12.5" />
                        </Border>

                        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Diag.Encoders}"
                                           Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <TextBox Text="{Binding DiagnosticsText, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         Background="#0A0D11" BorderThickness="0"
                                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                                         TextWrapping="NoWrap" />
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Diag.Log}"
                                           Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                         Background="#0A0D11" BorderThickness="0"
                                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                                         TextWrapping="NoWrap" TextChanged="LogBox_TextChanged" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</Window>
